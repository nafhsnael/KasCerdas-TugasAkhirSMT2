                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/transactions?from=2026-05-01&to=2026-05-31&type=expense&category=Makan",
              "host": ["{{base_url}}"],
              "path": ["api", "transactions"],
              "query": [
                {
                  "key": "from",
                  "value": "2026-05-01"
                },
                {
                  "key": "to",
                  "value": "2026-05-31"
                },
                {
                  "key": "type",
                  "value": "expense"
                },
                {
                  "key": "category",
                  "value": "Makan"
                }
              ]
            }
          }
        },
